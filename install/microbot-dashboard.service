[Unit]
Description=MicroBot Dashboard (solo lectura)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/microbot/dashboard
ExecStart=/usr/bin/python3 /opt/microbot/dashboard/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
